# --- Mealie ---------------------------------------------------------------
MEALIE_URL=https://recipes.example.com
MEALIE_API_TOKEN=            # API token of a dedicated, non-admin Mealie user
#MEALIE_PUBLIC_URL=          # base for links shown to users, if MEALIE_URL is internal
#MEALIE_TIMEOUT=30
#MEALIE_VERIFY_TLS=true

# --- Server ---------------------------------------------------------------
#MEALIE_MCP_READ_ONLY=false
#MEALIE_MCP_TRANSPORT=http   # image default; stdio when run from a shell
#MEALIE_MCP_HOST=0.0.0.0     # image default
#MEALIE_MCP_PORT=8000
#MEALIE_MCP_PATH=/mcp
#MEALIE_MCP_STATELESS_HTTP=false
#MEALIE_MCP_LOG_LEVEL=INFO

# --- Inbound auth: none | bearer | oidc ------------------------------------
MEALIE_MCP_AUTH_MODE=bearer
MEALIE_MCP_BEARER_TOKENS=    # comma-separated; generate with: openssl rand -hex 32

# oidc mode (claude.ai connectors). Provider redirect URI: <MEALIE_MCP_BASE_URL>/auth/callback
#MEALIE_MCP_AUTH_MODE=oidc
#MEALIE_MCP_BASE_URL=https://mealie-mcp.example.com
#MEALIE_MCP_OIDC_ISSUER=https://id.example.com
#MEALIE_MCP_OIDC_CLIENT_ID=
#MEALIE_MCP_OIDC_CLIENT_SECRET=
#MEALIE_MCP_OIDC_FORWARD_RESOURCE=false  # true only if the provider needs RFC 8707 resource
#MEALIE_MCP_JWT_SIGNING_KEY= # optional; openssl rand -hex 32
#MEALIE_MCP_STATE_DIR=/data  # image default; mount a volume here
